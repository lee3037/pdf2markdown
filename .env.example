MINERU_MODE=mock
DATA_DIR=data
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
# To connect: set MINERU_MODE=remote and verify the gateway's actual OpenAPI first.
# MINERU_BASE_URL=http://<mineru-host>:19091
# MINERU_API_KEY=
# Leave unset to retain the server's deployed backend.
# MINERU_BACKEND=pipeline
MINERU_PARSE_METHOD=auto
MINERU_LANGUAGE=ch
MINERU_CONNECT_TIMEOUT=5
MINERU_REQUEST_TIMEOUT=60
MINERU_POLL_INTERVAL=2
MINERU_POLL_TIMEOUT=900
# Change after replacing server models/configuration without changing the version.
MINERU_CACHE_NAMESPACE=v1
